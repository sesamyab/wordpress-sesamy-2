\n\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t<div class=\"wrap\" id=\"sesamy-settings\">\n\t\t\t<h1>Sesamy Settings</h1>\n\t\t\t\t\t<h2>Connection</h2>\n\t\t\t\t\t<p>Connect this site to your Sesamy account to enable content gating and reader entitlements.</p>\n\t\t\t<form action=\"http://localhost:8888/wp-admin/admin-post.php\" method=\"post\" style=\"margin-bottom: 2em;\">\n\t\t\t\t<input type=\"hidden\" name=\"action\" value=\"sesamy_connect_start\">\n\t\t\t\t<input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"960d6f7ddc\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/wp-admin/admin.php?page=sesamy&#038;state=0de890b35755715448e2a8b2e9ff2e3cff0b4b9b1ac5703e1f87a8101ee5017b&#038;authhero_iat=rwhdY0cl3jboMMgGJqVM140GrY1F089tGWrdKA_ohLE&#038;authhero_tenant=ehandel\" />\t\t\t\t<input type=\"submit\" name=\"submit\" id=\"submit\" class=\"button button-primary\" value=\"Connect to Sesamy\"  />\t\t\t</form>\n\t\t\t\t\t\t\t<form action=\"options.php\" method=\"post\">\n\t\t\t\t<input type='hidden' name='option_page' value='sesamy' /><input type=\"hidden\" name=\"action\" value=\"update\" /><input type=\"hidden\" id=\"_wpnonce\" name=\"_wpnonce\" value=\"8956ec1939\" /><input type=\"hidden\" name=\"_wp_http_referer\" value=\"/wp-admin/admin.php?page=sesamy&#038;state=0de890b35755715448e2a8b2e9ff2e3cff0b4b9b1ac5703e1f87a8101ee5017b&#038;authhero_iat=rwhdY0cl3jboMMgGJqVM140GrY1F089tGWrdKA_ohLE&#038;authhero_tenant=ehandel\" /><table class=\"form-table\" role=\"presentation\"><tr><th scope=\"row\"><label for=\"default_currency\">Default Currency</label></th><td><select id=\"default_currency\" name=\"sesamy_settings[default_currency]\" class=\"regular-text\"><option value=\"\" >Select</option><option value=\"DKK\" >DKK</option><option value=\"GBP\" >GBP</option><option value=\"USD\" >USD</option><option value=\"SEK\"  selected=&#039;selected&#039;>SEK</option><option value=\"EUR\" >EUR</option><option value=\"NOK\" >NOK</option></select></td></tr><tr><th scope=\"row\"><label for=\"default_price\">Default Article Price</label></th><td><input type=\"text\" id=\"default_price\" name=\"sesamy_settings[default_price]\" value=\"19\" class=\"regular-text\" /></td></tr><tr><th scope=\"row\"><label for=\"default_paywall\">Default Paywall</label></th><td><input type=\"text\" id=\"default_paywall\" name=\"sesamy_settings[default_paywall]\" value=\"https://api.sesamy.dev/paywall/paywalls/acme/OxHlsEHTUGs1tpF6EoRy8.json\" class=\"regular-text\" /></td></tr><tr><th scope=\"row\"><label for=\"default_pass\">Default Pass</label></th><td><input type=\"text\" id=\"default_pass\" name=\"sesamy_settings[default_pass]\" value=\"https://sesamy.dev/digital\" class=\"regular-text\" /></td></tr><tr><th scope=\"row\">Lock Mode</th><td><select id=\"lock_mode\" name=\"sesamy_settings[lock_mode]\" class=\"regular-text\"><option value=\"encode\"  selected=&#039;selected&#039;>Encode</option><option value=\"embed\" >Embed</option></select></td></tr><tr><th scope=\"row\">Content Types</th><td><fieldset><label><input type=\"checkbox\" name=\"sesamy_settings[enabled_content_types][]\" value=\"post\"  checked=&#039;checked&#039;>Post</label><br><label><input type=\"checkbox\" name=\"sesamy_settings[enabled_content_types][]\" value=\"page\"  checked=&#039;checked&#039;>Page</label><br></fieldset></td></tr><tr><th scope=\"row\"><label for=\"Enabled\">Development Mode</label></th><td><label><input type=\"checkbox\" name=\"sesamy_settings[development_mode]\" value=\"1\" >Enabled</label></td></tr></table><p class=\"submit\"><input type=\"submit\" name=\"submit\" id=\"submit\" class=\"button button-primary\" value=\"Save Settings\"  /></p>\t\t\t</form>\n\t\t</div>\n\t\t\n<div class=\"clear\"></div></div><!-- wpbody-content -->\n<div class=\"clear\"></div></div><!-- wpbody -->\n<div class=\"clear\"></div></div><!-- wpcontent -->\n\n<div id=\"wpfooter\" role=\"contentinfo\">\n\t\t<p id=\"footer-left\" class=\"alignleft\">\n\t\t<span id=\"footer-thankyou\">