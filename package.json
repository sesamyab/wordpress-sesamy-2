{
  "name": "sesamy-wp-plugin",
  "version": "1.2.18",
  "description": "Sesamy WordPress plugin",
  "scripts": {
    "wp-env": "wp-env start",
    "watch": "10up-toolkit watch --port=5010 --hot",
    "build": "10up-toolkit build",
    "format-js": "10up-toolkit format-js",
    "lint-js": "10up-toolkit lint-js",
    "lint-style": "10up-toolkit lint-style",
    "test": "10up-toolkit test-unit-jest --passWithNoTests",
    "test:php": "vendor/bin/phpunit",
    "test:php:watch": "vendor/bin/phpunit --testdox --colors=always",
    "clean-dist": "rm -rf ./dist",
    "prepare": "husky",
    "update-plugin-version": "node update-plugin-version.js",
    "release": "commit-and-tag-version -a --no-verify"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "10up-toolkit": "6.4.1",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "19.8.0",
    "commit-and-tag-version": "12.5.1",
    "husky": "9.1.7",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.5.0"
  },
  "dependencies": {
    "@wordpress/api-fetch": "^7.20.0",
    "@wordpress/components": "^29.6.0",
    "@wordpress/data": "^10.20.0",
    "@wordpress/dom-ready": "^4.20.0",
    "@wordpress/element": "^6.20.0",
    "@wordpress/notices": "^5.20.0",
    "prop-types": "^15.7.2"
  },
  "10up-toolkit": {
    "devURL": "http://127.0.0.1:8888",
    "entry": {
      "admin": "./assets/js/admin.js",
      "post-settings": "./assets/js/post-settings.js"
    }
  },
  "commit-and-tag-version": {
    "scripts": {
      "precommit": "npm run update-plugin-version && git add sesamy2.php"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
